# Copy to .env for local runs. In GitHub Actions these are repository secrets
# instead - never commit real values.

# --- Stage 1: Gmail (App Password, NOT your Google password) ---------------
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop
IMAP_HOST=imap.gmail.com
IMAP_FOLDER=INBOX
LOOKBACK_DAYS=2

# --- Stage 3: JD enrichment ------------------------------------------------
ENRICH_ENABLED=true
ENRICH_TOP_N=12
ENRICH_MIN_DELAY=2.5
ENRICH_MAX_DELAY=6.0

# --- Stage 4: optional AI scoring ------------------------------------------
LLM_ENABLED=false
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TOP_N=15
# Optional: any OpenAI-compatible endpoint (Groq, Together, local). Blank = OpenAI.
LLM_BASE_URL=

# --- Stage 5: Google Sheets ------------------------------------------------
# SHEET_ID is the long id in the sheet URL:
# https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
SHEET_TAB=Jobs
# Local: point at the downloaded key file (keep it OUTSIDE this repo folder).
GOOGLE_SERVICE_ACCOUNT_FILE=C:/Users/you/.secrets/job-radar-sa.json
# GitHub Actions uses this one instead - the whole key file pasted as a secret.
# Leave it blank locally; the .env reader here is single-line only.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Phase 4: optional morning digest --------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DIGEST_MIN_SCORE=70
